# Flask
FLASK_ENV=development
SECRET_KEY=change-this-in-production

# MySQL 8
# DB_HOST=localhost for a local MySQL install; docker-compose overrides
# this to DB_HOST=mysql automatically (the service name), so leave it
# as localhost here for local (non-Docker) development.
DB_USER=eakms_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eakms_db

# Only used by docker-compose to initialize the MySQL container's root account
MYSQL_ROOT_PASSWORD=change-me-root

# Embeddings (added Phase 7)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Gemini API (added Phase 8)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_TEMPERATURE=0.2

# Test DB (optional)
TEST_DATABASE_URL=mysql+pymysql://root:root@localhost:3306/eakms_test_db
